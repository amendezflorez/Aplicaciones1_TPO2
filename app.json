{
  "expo": {
    "name": "Aplicaciones1_TPO2",
    "slug": "Aplicaciones1_TPO2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que $(PRODUCT_NAME) use Face ID para desbloquear la sesión."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que $(PRODUCT_NAME) acceda a tus fotos para elegir la foto de perfil.",
          "cameraPermission": "Permitir que $(PRODUCT_NAME) use la cámara para tomar la foto de perfil."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ]
  }
}
